<?xml version="1.0"?>
<model>
  <name>wind_turbine</name>
  <version>0.1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>floatgen</name>
    <email>maintainer@example.com</email>
  </author>
  <description>
    Static bottom-fixed NREL-5MW wind turbine.
    Meshes are authored in the assembled global frame (tower base at model origin),
    so every visual/collision sits at identity pose relative to the model frame.
    Place with a model pose for x/y/yaw in the world.
  </description>
</model>
